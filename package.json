{
  "name": "effect-cf-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "node scripts/patch-effect-tsgo.ts && vp config --no-agent --hooks-dir .vite-hooks",
    "patch:tsgo": "node scripts/patch-effect-tsgo.ts",
    "build": "pnpm run patch:tsgo && pnpm -r --filter './packages/*' run build",
    "check:types": "vp run typecheck",
    "test": "vp test",
    "check:containers": "vp run test:containers",
    "lint": "vp lint",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "ready": "vp run check && pnpm run build",
    "changeset": "vp exec changeset",
    "changeset:version": "vp exec changeset version",
    "changeset:publish": "vp exec changeset publish",
    "dev": "vp run @systemfsoftware/effect-cf#build && vp run outbox-example#dev"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.0",
    "@cloudflare/vitest-plugin": "catalog:",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@effect-cf/repo": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "0.36.4",
    "@effect/vitest": "catalog:",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "1.4.0",
    "@types/node": "25.9.3",
    "@yielded/effect-tsrs": "0.2.3",
    "effect": "catalog:",
    "esbuild": "0.28.2",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "workerd": "catalog:",
    "wrangler": "catalog:",
    "dprint": "0.65.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.9.0"
}
